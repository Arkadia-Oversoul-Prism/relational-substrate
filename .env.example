# ── relational-substrate — Environment Variables ──────────────────────────────
# Copy to .env and fill in. NEVER commit real values.

# ── Core AI providers ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
# Gemini. Without it the planner falls back to its deterministic path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── GitHub corpus sync ────────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
# Read-only repo access for corpus sync. Without it only public files are seen.

# ── Sovereign access ──────────────────────────────────────────────────────────
SOVEREIGN_KEY=
# Gates /api/forge. Production must use a deployment-managed secret.

# ── Firebase (optional — persistent state via Firestore) ──────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
# Full JSON string of a service account key. When unset, state is local-only.

# ── Kernel tuning ─────────────────────────────────────────────────────────────
SOLSPIRE_WORKERS=2
SOLSPIRE_GOAL_TICK_SECONDS=15
SOLSPIRE_DATA_DIR=data
# Directory for local JSON snapshots and the SQLite project store.

# ── Knowledge OS ──────────────────────────────────────────────────────────────
ARKADIA_DB_PATH=
# SQLite path for the Knowledge OS. Defaults to the vault/data location.
ARKADIA_VAULT_PATH=
# Vault root for note projections.

# ── TTS (optional) ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Without it the TTS kernel falls back to Edge TTS.

# ── Autonomous Weaver ─────────────────────────────────────────────────────────
ARKADIA_RECURSIVE_ENABLED=false
ARKADIA_RECURSIVE_DEPTH=3
ARKADIA_RECURSIVE_INTERVAL=1.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
# ARKADIA_RATE_LIMIT=1
# ARKADIA_RL_RESONANCE=20/60
# ARKADIA_RL_PERSONAL=15/60
# ARKADIA_RL_SEARCH=60/60
# ARKADIA_RL_KNOWLEDGE=90/60
# ARKADIA_RL_API=120/60

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
